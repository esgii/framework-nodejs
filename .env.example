# --- Mode ---
# development | production | test
NODE_ENV=development

# --- Server ---
HOST=0.0.0.0
PORT=3000
# Taille max du corps de requête, en octets (1 Mo)
BODY_LIMIT_BYTES=1000000

# --- Dtabase ---
# DATABASE_URL=postgres://carnet:CHANGE_ME@localhost:5432/carnet

# --- Authentification ---
# Générer : node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))" pour JWT_SECRET
JWT_SECRET=
JWT_TTL_SECONDS=3600
BCRYPT_COST=12

# --- CORS ---
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:5173

# --- Uploads ---
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5000000
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# --- Rate limit ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- API ---
API_DEFAULT_VERSION=v1
